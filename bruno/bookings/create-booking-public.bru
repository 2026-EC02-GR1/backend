meta {
  name: Create Booking (public)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/bookings/public
  body: json
  auth: none
}

body:json {
  {
    "property_id": "{{property_id}}",
    "hold_slot_id": "{{hold_slot_id}}",
    "check_in": "2026-07-01",
    "check_out": "2026-07-08",
    "nb_guests": 2,
    "client": {
      "last_name": "Dupont",
      "first_name": "Jean",
      "email": "jean.dupont@example.com",
      "phone": "+33612345678"
    }
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("booking_id", res.body.id);
  }
}
