meta {
  name: Upload Photo
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/properties/{{property_id}}/photos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file()
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("photo_id", res.body.id);
  }
}
