meta {
  name: Sign In
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Origin: {{base_url}}
}

body:json {
  {
    "email": "manager@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setVar("token", res.body.token);
  }
}
