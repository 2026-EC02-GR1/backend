meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Origin: {{base_url}}
}

body:json {
  {
    "name": "Test Manager",
    "email": "manager@example.com",
    "password": "password123"
  }
}

vars:pre-request {
  base_url: http://localhost:3000
}
