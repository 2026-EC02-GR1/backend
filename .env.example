# Copy to .env and adjust. Loaded automatically by Bun and Docker Compose.

POSTGRES_USER=resa
POSTGRES_PASSWORD=resa
POSTGRES_DB=resa
POSTGRES_PORT=5432

# Bun expands ${VAR} references in .env files.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
