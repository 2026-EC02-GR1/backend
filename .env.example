# Copy to .env and adjust. Loaded automatically by Bun and Docker Compose.

POSTGRES_USER=resa
POSTGRES_PASSWORD=resa
POSTGRES_DB=resa
POSTGRES_PORT=5432

# Bun expands ${VAR} references in .env files.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# Server
PORT=3000
BASE_URL=http://localhost:3000

# better-auth — generate a strong random secret for production
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# Widget CDN (default: https://cdn.resa.com)
WIDGET_CDN_URL=https://cdn.resa.com

# Reservation microservice (../service_reservation) — bookings, hold-slots and
# availability routes are proxied there.
RESERVATION_SERVICE_URL=http://localhost:3001

# Stripe — use test keys locally (sk_test_… / whsec_…)
# STRIPE_WEBHOOK_SECRET: run `stripe listen --forward-to localhost:3000/api/v1/payments/webhook --api-key $STRIPE_API`
# and copy the whsec_… printed by the CLI.
STRIPE_API=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me







